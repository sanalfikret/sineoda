#!/usr/bin/env bash
# Cursor/AI author ile commit engelle — yalnızca repodaki geliştirici (Fikret / Plooy)
set -euo pipefail
ident="$(git var GIT_AUTHOR_IDENT 2>/dev/null || true)"
email="$(printf '%s' "$ident" | sed -n 's/.*<\([^>]*\)>.*/\1/p')"
name="$(printf '%s' "$ident" | sed -n 's/^\([^<]*\).*/\1/' | sed 's/[[:space:]]*$//')"
if printf '%s' "$email$name" | grep -qiE 'cursor|cursoragent|composer@|openai'; then
  echo "HATA: Commit author Cursor/AI olamaz ($ident)."
  echo "git config user.name ve user.email Fikret / GitHub hesabın olmalı."
  exit 1
fi
