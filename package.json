{
  "name": "sineoda",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "npm run dev --prefix server",
    "build": "tsc -b && vite build",
    "build:cpanel": "vite build",
    "build:server": "npm run build --prefix server",
    "check:server": "node scripts/check-server-boot.mjs",
    "check:deploy": "npm run check:server && npm run build:cpanel",
    "deploy:vps": "powershell -File deploy/sync-to-vps.ps1",
    "icons": "node scripts/generate-pwa-icons.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "hls.js": "^1.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
