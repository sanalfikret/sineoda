PORT=3001
JWT_SECRET=degistir-guclu-bir-secret
FRONTEND_URL=http://localhost:5173
PUBLIC_URL=http://localhost:3001
REQUIRE_SUBSCRIPTION=true

# Ödeme sağlayıcısı: paytr | iyzico
PAYMENT_PROVIDER=paytr

# PayTR (https://www.paytr.com)
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1

# iyzico (https://www.iyzico.com)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Kalıcı depolama (Docker / VPS / Render disk)
# Render: persistent disk mount /var/data, then DATA_DIR=/var/data
# DATA_DIR=/var/data
# UPLOADS_DIR=/var/data/uploads
# WEB_DIST_DIR=/app/web-dist

# SMS doğrulama (NetGSM örneği)
REQUIRE_SMS_VERIFICATION=true
# SMS_PROVIDER=netgsm
# NETGSM_USER=
# NETGSM_PASS=
# NETGSM_HEADER=SINEODA
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_xxxx
# SMTP_FROM=Plooy <noreply@Plooy.com>
