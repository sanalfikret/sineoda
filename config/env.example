# =============================================================================
# Plooy — TEK YAPILANDIRMA DOSYASI
# =============================================================================
# Yerel:  cp config/env.example .env
# VPS:    cp config/env.example .env  → nano .env  → bash deploy/rebuild-vps.sh
#
# Sunucu taşırken yalnızca bu dosyayı güncelle; kodda domain arama.
# Detay: config/AYARLAR.txt
# =============================================================================

# --- Sunucu (Node API) ---
HOST_PORT=3001
PORT=3001

# Canlı site adresi (sonda / yok). Tek domain: site + API aynı adreste.
# Yerel: localhost | Canlı: https://plooy.tv
FRONTEND_URL=http://localhost:5173
PUBLIC_URL=http://localhost:3001
# FRONTEND_URL=https://plooy.tv
# PUBLIC_URL=https://plooy.tv

# İsteğe bağlı: ek CORS kökenleri (virgülle). Boş = FRONTEND_URL + yerel dev.
# CORS_ORIGINS=https://www.ornek.com,https://ornek.com

# Zorunlu (production, min 32 karakter). Deploy sonrası değiştirmeyin — oturumlar düşer.
JWT_SECRET=yerel-gelistirme-icin-degistirin-min-32-karakter

# Production'da ilk admin yoksa (min 12 karakter). Boş bırakılırsa varsayılan admin123 oluşturulmaz.
# ADMIN_BOOTSTRAP_PASSWORD=

# Kalıcı veri (VPS). Deploy bu klasöre dokunmaz.
PERSIST_DIR=./persistent

# --- Frontend build (Vite) ---
# Same-origin VPS: BOŞ bırak. Ayrı API subdomain ise: https://api.ornek.com
VITE_API_URL=

# E-posta domain (UI yedek metinleri). Gerçek SMTP ayrı.
# EMAIL_DOMAIN=plooy.tv
# VITE_EMAIL_DOMAIN=plooy.tv
# CONTACT_EMAIL=destek@ornek.com
# KVKK_EMAIL=kvkk@ornek.com

# --- Özellik bayrakları ---
# PayTR gelene kadar canlıda: REQUIRE_SUBSCRIPTION=false (herkes izler)
# PayTR anahtarları eklenince: REQUIRE_SUBSCRIPTION=true + PAYTR_TEST_MODE=0
REQUIRE_SUBSCRIPTION=false
REQUIRE_SMS_VERIFICATION=false
PAYTR_TEST_MODE=1

# --- Ödeme (yalnızca PayTR) ---
PAYMENT_PROVIDER=paytr
# PAYTR_MERCHANT_ID=
# PAYTR_MERCHANT_KEY=
# PAYTR_MERCHANT_SALT=

# --- E-posta (canlıya geçince) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Plooy <noreply@ornek.com>

# --- SMS (canlıya geçince) ---
# SMS_PROVIDER=netgsm
# NETGSM_USER=
# NETGSM_PASS=
# NETGSM_HEADER=PLOOY
