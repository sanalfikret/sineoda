# Kopyala: cp deploy/env.production.example .env
# Tek domain örneği: https://sineoda.com hem site hem API

HOST_PORT=3001

# Zorunlu — rastgele uzun bir değer (openssl rand -hex 32). Deploy sonrası değiştirmeyin; oturumlar düşer.
JWT_SECRET=buraya-guclu-random-secret

# Production'da yok sayılır (her zaman 30 gün). Yalnızca local test için kullanın.
# JWT_EXPIRES_IN=30d

# Canlı site adresin (sonda / olmasın)
FRONTEND_URL=https://sineoda.com
PUBLIC_URL=https://sineoda.com

# Deneme / soft launch
REQUIRE_SUBSCRIPTION=false
REQUIRE_SMS_VERIFICATION=false
PAYTR_TEST_MODE=1

# Frontend build: API aynı domain'deyse boş bırak (Render URL YAZMA — istekler yanlış sunucuya gider)
VITE_API_URL=

# Kalıcı veri — deploy/rebuild bu klasörü silmez (git dışında tutulur)
PERSIST_DIR=/opt/sineoda/persistent

# Ödeme (hazır olunca)
# PAYMENT_PROVIDER=paytr
# PAYTR_MERCHANT_ID=
# PAYTR_MERCHANT_KEY=
# PAYTR_MERCHANT_SALT=

# E-posta (hazır olunca)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Sineoda <noreply@sineoda.com>
