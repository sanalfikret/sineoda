# cPanel "Setup Node.js App" — uygulama kökü: sineoda-api/ (zip içeriği)
# KULLANICIADI = cPanel kullanıcı adın (/home/KULLANICIADI/...)

PORT=3001
JWT_SECRET=guclu-random-secret-buraya-degistir
FRONTEND_URL=https://birtakimislerdizi.com
PUBLIC_URL=https://api.birtakimislerdizi.com
REQUIRE_SUBSCRIPTION=false
REQUIRE_SMS_VERIFICATION=false
DATA_DIR=/home/KULLANICIADI/sineoda-api/data
UPLOADS_DIR=/home/KULLANICIADI/sineoda-api/uploads

# İsteğe bağlı — e-posta / ödeme / SMS (boş bırakılabilir)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Plooy <noreply@birtakimislerdizi.com>
